# ==========================================================
# SACRANET - VARIABLES DE ENTORNO
# ==========================================================
# Copie este archivo como .env y ajuste los valores.
# Nunca suba el archivo .env a GitHub.

# ----------------------------------------------------------
# Django
# ----------------------------------------------------------
DEBUG=False

# Genere una clave nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambie-esta-clave-por-una-generada

# Para una red local puede usar *; en produccion escriba los dominios/IPs reales.
ALLOWED_HOSTS=*

# Agregue http://IP_DEL_EQUIPO cuando acceda desde otra computadora.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ----------------------------------------------------------
# PostgreSQL principal
# ----------------------------------------------------------
POSTGRES_DB=SACRANET_BD
POSTGRES_USER=sacranet
POSTGRES_PASSWORD=cambie-esta-contrasena

# Dentro de Docker el host siempre es el nombre del servicio: db.
DB_HOST=db
DB_PORT=5432

# ----------------------------------------------------------
# Bases de datos de agenda e historial
# ----------------------------------------------------------
# Por compatibilidad con la arquitectura actual, agenda e historial
# usan SQLite dentro de un volumen persistente.
#
# Para usar PostgreSQL para ambas, cambie el valor a postgresql y
# descomente AGENDA_DB_NAME / HISTORIAL_DB_NAME.
AGENDA_DB_ENGINE=sqlite3
HISTORIAL_DB_ENGINE=sqlite3

# AGENDA_DB_NAME=agenda
# HISTORIAL_DB_NAME=historial

# ----------------------------------------------------------
# Gunicorn
# ----------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ----------------------------------------------------------
# Puerto HTTP publicado por Nginx
# ----------------------------------------------------------
HTTP_PORT=80

# ----------------------------------------------------------
# Opciones para HTTPS futuro
# ----------------------------------------------------------
# USE_X_FORWARDED_PROTO=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
